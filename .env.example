# ── AgentBreak Configuration ───────────────────────────────
# Copy to .env and fill in your values.

# Gemini API
GEMINI_API_KEY=
# Model names (change without touching code)
VICTIM_MODEL=gemini-3.8-flash
ATTACKER_MODEL=gemini-3.8-flash
CLASSIFIER_MODEL=gemini-3.8-flash

# Temperatures
VICTIM_TEMPERATURE=0.1
ATTACKER_TEMPERATURE=0.8
CLASSIFIER_TEMPERATURE=0.0

# Agent settings
MAX_AGENT_STEPS=8
ATTACK_BUDGET_K=10

# API call management
REQUEST_BUDGET=500
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RATE_LIMIT_RPM=15

# Database
DATABASE_URL=sqlite+aiosqlite:///./agentbreak.db

# Trace integrity HMAC secret
TRACE_SEAL_KEY=

# Demo mode (set to true to serve cached data without API calls)
DEMO_MODE=false
